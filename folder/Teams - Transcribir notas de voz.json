    {
      "parameters": {
        "jsCode": "// n8n nombra el binario \"$value\" (ultimo segmento de la URL), sin extension.\n// La API de transcripcion valida el formato por el nombre del archivo,\n// asi que hay que renombrarlo antes de enviarlo.\n\nfor (const item of $input.all()) {\n  if (item.binary?.data) {\n    item.binary.data.fileName = 'audio.m4a';\n    item.binary.data.fileExtension = 'm4a';\n    item.binary.data.mimeType = 'audio/mp4';\n  }\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        64
      ],
      "id": "7d84a92e-1ef5-4de4-bd6a-7212fe5c9dd0",
      "name": "Renombrar binario"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "messageId",
              "value": "={{ $('Extraer URL de audio1').item.json.messageId }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "autor",
              "value": "={{ $('Extraer URL de audio1').item.json.autor }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "fecha",
              "value": "={{ $('Extraer URL de audio1').item.json.fecha }}",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "duracion",
              "value": "={{ $('Extraer URL de audio1').item.json.duracion }}",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "transcripcion",
              "value": "={{ $json.text }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1424,
        64
      ],
      "id": "ba8c4501-8889-405d-86ff-739b7ec5e488",
      "name": "Resultado"
    },
    {
      "parameters": {
        "jsCode": "// Filtra solo los mensajes con nota de voz y extrae la URL del audio.\n// El campo attachment.content es un JSON escapado como string.\n\nconst salida = [];\n\nfor (const item of $input.all()) {\n  const msg = item.json;\n  const adjuntos = msg.attachments || [];\n\n  for (const a of adjuntos) {\n    if (a.contentType !== 'application/vnd.microsoft.card.audio') continue;\n\n    let card;\n    try {\n      card = JSON.parse(a.content);\n    } catch (e) {\n      continue; // content mal formado, lo salteamos\n    }\n\n    const url = card?.media?.[0]?.url;\n    if (!url) continue;\n\n    salida.push({\n      json: {\n        messageId: msg.id,\n        chatId: msg.chatId,\n        autor: msg.from?.user?.displayName || null,\n        fecha: msg.createdDateTime,\n        duracion: card.duration || null,\n        audioUrl: url\n      }\n    });\n  }\n}\n\nreturn salida;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
